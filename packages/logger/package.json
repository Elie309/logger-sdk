{
  "name": "@elie309/logger",
  "version": "0.1.0",
  "description": "Structured, non-blocking logger SDK for TypeScript with batching, retries, redaction and pluggable transports",
  "license": "MIT",
  "author": "Elie Saade",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elie309/logger-sdk.git",
    "directory": "packages/logger"
  },
  "keywords": [
    "logger",
    "logging",
    "structured-logging",
    "typescript",
    "observability"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./file": {
      "import": {
        "types": "./dist/file.d.ts",
        "default": "./dist/file.js"
      },
      "require": {
        "types": "./dist/file.d.cts",
        "default": "./dist/file.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint:pkg": "publint && attw --pack . --profile node16"
  },
  "dependencies": {
    "@elie309/contracts": "workspace:^"
  },
  "devDependencies": {
    "@elie309/test-utils": "workspace:^"
  }
}
