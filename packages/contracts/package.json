{
  "name": "@elie309/contracts",
  "version": "0.1.0",
  "description": "Shared event schemas and API contracts for the elie309 logger SDK",
  "license": "MIT",
  "author": "Elie Saade",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elie309/logger-sdk.git",
    "directory": "packages/contracts"
  },
  "keywords": [
    "logger",
    "logging",
    "schema",
    "zod",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint:pkg": "publint && attw --pack . --profile node16"
  },
  "dependencies": {
    "zod": "^4.1.0"
  }
}
